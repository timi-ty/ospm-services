[Unit]
Description=OSPM Data Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ospm-services/data-service
ExecStart=/home/ubuntu/ospm-services/data-service/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
EnvironmentFile=/home/ubuntu/ospm-services/.env
Environment=LOG_LEVEL=INFO

[Install]
WantedBy=multi-user.target
