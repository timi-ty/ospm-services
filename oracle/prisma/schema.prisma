generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Market {
  id                String   @id @default(cuid())
  
  // Core market info
  question          String
  description       String?
  category          String
  sourceUrl         String
  
  // On-chain
  contractAddress   String?  @unique
  
  // Timing
  bettingClosesAt   DateTime
  resolvesAt        DateTime
  
  // Status
  status            String   @default("pending")
  resolvedOutcome   Boolean?
  resolutionContext  String?
  
  // LMSR state (cached from chain for fast reads)
  b                 Float    @default(100)
  qYes              Float    @default(0)
  qNo               Float    @default(0)
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deployedAt        DateTime?
  resolvedAt        DateTime?
  proposedAt        DateTime?
  
  // Relations
  bets              Bet[]

  @@unique([question, bettingClosesAt])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

model User {
  id              String    @id @default(cuid())
  privyUserId     String    @unique
  address         String    @unique
  lastGasClaimAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  bets            Bet[]
}

model Bet {
  id          String   @id @default(cuid())
  marketId    String
  userId      String?
  
  visitorId   String?
  outcome     Boolean
  shares      Float
  costBasis   Float
  claimed     Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  
  market      Market   @relation(fields: [marketId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])
  
  @@index([marketId])
  @@index([userId])
  @@index([visitorId])
  @@index([createdAt])
}

model HealthLog {
  id          String   @id @default(cuid())
  tickCount   Int
  status      String
  details     String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
